# Generated track data is written with LF by the tools (ats-dress, ats-smooth,
# osm_layout.py, ...) on every platform. Pinning it to LF in the working tree
# too keeps a Windows checkout with core.autocrlf from listing every re-dressed
# scene as modified when only its line endings differ. (The content checksum
# drops carriage returns, so the server and client agree either way.)
apexsim-content/tracks/default/**/*.ats          text eol=lf
apexsim-content/tracks/default/**/*.yaml         text eol=lf
apexsim-content/tracks/default/**/*.layout.json  text eol=lf
apexsim-content/tracks/default/**/*.msgpack      binary

# The marketing page: apexsim/site/ is its source, apexsim/docs/ what scripts/site/build_site.py
# writes from it (LF, so `--check` and a Windows checkout agree).
apexsim/site/*.yml               text eol=lf
apexsim/site/*.html              text eol=lf
apexsim/site/*.css               text eol=lf
apexsim/site/*.js                text eol=lf
apexsim/site/*.json              text eol=lf
apexsim/site/*.md                text eol=lf
apexsim/site/shots/*             binary
apexsim/docs/index.html          text eol=lf
apexsim/docs/assets/*.css        text eol=lf
apexsim/docs/assets/*.js         text eol=lf
apexsim/docs/assets/*.json       text eol=lf
apexsim-content/**/*.png filter=lfs diff=lfs merge=lfs -text
apexsim-content/**/*.blend filter=lfs diff=lfs merge=lfs -text
apexsim-content/**/*.glb filter=lfs diff=lfs merge=lfs -text
apexsim-content/**/*.msgpack filter=lfs diff=lfs merge=lfs -text
apexsim-content/**/*.jpg filter=lfs diff=lfs merge=lfs -text
apexsim/game-unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text
apexsim/game-unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text
apexsim/game-unreal/**/*.bmp filter=lfs diff=lfs merge=lfs -text

# Shell scripts run in Linux containers: keep LF.
*.sh text eol=lf
