# Generated track data is written with LF by the tools (ats-dress, ats-smooth,
# osm_layout.py, ...) on every platform. Pinning it to LF in the working tree
# too keeps a Windows checkout with core.autocrlf from listing every re-dressed
# scene as modified when only its line endings differ. (The content checksum
# drops carriage returns, so the server and client agree either way.)
content/tracks/default/*.ats          text eol=lf
content/tracks/default/*.yaml         text eol=lf
content/tracks/default/*.layout.json  text eol=lf
content/tracks/default/*.msgpack      binary

# The marketing page: site/ is its source, docs/ what scripts/site/build_site.py
# writes from it (LF, so `--check` and a Windows checkout agree).
site/*.yml               text eol=lf
site/*.html              text eol=lf
site/*.css               text eol=lf
site/*.js                text eol=lf
site/*.json              text eol=lf
site/*.md                text eol=lf
site/shots/*             binary
docs/index.html          text eol=lf
docs/assets/*.css        text eol=lf
docs/assets/*.js         text eol=lf
docs/assets/*.json       text eol=lf
