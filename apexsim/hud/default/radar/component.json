// The proximity radar: a car alongside, left or right, that the mirrors do
// not show. A bar lights on that side and fills as the gap closes, going
// red; hidden while no car is alongside.
{
  "name": "Radar",
  "region": "bottom",
  "order": 0,
  "visible": "=(radar.left || radar.right) && !spectate.active",
  "root": {
    "type": "row",
    "children": [
      { "type": "bar", "width": 14, "height": 88, "direction": "up", "background": "=alpha('text_muted', 0.25)",
        "value": "=radar.left ? clamp(1 - radar.left_m / 3, 0.2, 1) : 0",
        "color": "=ramp(radar.left_m, 0, 'error', 2.5, 'accent')" },
      { "type": "column", "margin": [10, 0, 10, 0], "valign": "center",
        "children": [
          { "type": "rect", "width": 22, "height": 44, "radius": 5, "outline": "text_secondary", "outline_width": 2,
            "color": "=alpha('text_muted', 0.15)" },
          { "type": "label", "margin": [0, 6, 0, 0], "halign": "center",
            "text": "=radar.left && radar.right ? 'BOTH' : radar.left ? 'LEFT' : 'RIGHT'" }
        ]
      },
      { "type": "bar", "width": 14, "height": 88, "direction": "up", "background": "=alpha('text_muted', 0.25)",
        "value": "=radar.right ? clamp(1 - radar.right_m / 3, 0.2, 1) : 0",
        "color": "=ramp(radar.right_m, 0, 'error', 2.5, 'accent')" }
    ]
  }
}
