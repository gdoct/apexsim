// The virtual rear-view mirror (Camera settings), under the race state.
// It floats: it comes and goes with the setting, and the layout must not
// shift when it does. It only shows while the race director has a capture.
{
  "name": "Virtual mirror",
  "region": "top",
  "float": true,
  // A spectator has no car to look back from.
  "visible": "=!spectate.active",
  "margin": [0, 96, 0, 0],
  "root": { "type": "mirror", "width": 480, "height": 150 }
}
