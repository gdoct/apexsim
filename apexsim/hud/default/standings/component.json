// Five rows of the order around the player, each with the compound it runs
// on, and the session's fastest lap.
{
  "name": "Standings",
  "region": "bottom-left",
  "order": 20,
  // The timing tower has the whole field while watching.
  "visible": "=!spectate.active",
  "root": {
    "type": "column", "width": 366,
    "children": [
      { "type": "panel", "padding": [16, 9], "background": "surface_hover",
        "children": [{ "type": "label", "text": "Standings" }] },

      // One row per car, five at most, scrolled so the player sits in the
      // middle: in eleventh place the leaders are not who you are racing.
      {
        "type": "panel",
        "repeat": { "list": "standings", "max": 5, "focus": "is_local" },
        "height": 43, "margin": [0, 1, 0, 0], "padding": [16, 0],
        "background": "=item.is_local ? 'accent' : 'surface'",
        "children": [{
          "type": "row", "valign": "center",
          "children": [
            { "type": "text", "width": 22, "font": "mono", "size": 12, "text": "{item.position}",
              "color": "=item.is_local ? 'on_accent' : 'text_muted'" },
            { "type": "text", "fill": 1, "margin": [14, 0, 0, 0], "font": "body", "size": 14,
              "text": "=item.is_player ? 'YOU' : upper(item.name)",
              "bold": "=item.is_local",
              "color": "=item.is_local ? 'on_accent' : item.away ? 'text_muted' : 'text'" },
            // A driver who lost their connection: the server drives the car.
            { "type": "text", "margin": [8, 0, 0, 0], "font": "body", "size": 11, "bold": true,
              "visible": "=item.away", "text": "AWAY", "color": "text_muted" },
            // Race control's penalty, its seconds once added to the race
            // time; or the flag taken owing a stop or its second compound
            // (classified behind every car that met the pit rule).
            { "type": "panel", "valign": "center", "margin": [8, 0, 0, 0], "padding": [5, 0], "background": "error",
              "visible": "=item.missed_stops || item.penalty_owed || item.penalty_s > 0",
              "children": [{ "type": "text", "font": "body", "size": 11, "bold": true, "color": "on_accent",
                "text": "=item.penalty_s > 0 && !item.missed_stops ? 'PEN +' + item.penalty_s + 'S' : 'PEN'" }] },
            // The compound on the car, in its usual colour.
            { "type": "panel", "valign": "center", "width": 22, "height": 22, "radius": 11, "margin": [8, 0, 0, 0],
              "background": "=item.is_local ? alpha('black', 0.25) : 'background'",
              "outline": "=switch(item.compound, 'S', '#E8453C', 'M', '#F2C230', 'H', 'white', 'I', '#3BB54A', 'W', '#2F7DE1', 'border')", "outline_width": 2,
              "children": [{ "type": "text", "halign": "center", "valign": "center", "font": "body", "size": 11, "bold": true,
                "text": "=has(item.compound) ? item.compound : '·'",
                "color": "=switch(item.compound, 'S', '#E8453C', 'M', '#F2C230', 'H', 'white', 'I', '#3BB54A', 'W', '#2F7DE1', 'text_muted')" }] },
            // The leader's cell carries a lap time; everyone else's the gap to
            // them. A gap means nothing once a car has taken the flag, once
            // it is out, or for a car the qualifying cut-off left out (DNQ).
            { "type": "text", "margin": [10, 0, 0, 0], "font": "mono", "size": 13,
              "text": "=item.retired ? 'OUT' : item.dnq ? 'DNQ' : item.finished ? 'FINISHED' : item.position == 1 ? (has(item.best_lap_s) ? fmt_time(item.best_lap_s) : 'LEADER') : fmt_gap(item.gap_leader_s)",
              "color": "=item.is_local ? 'on_accent' : item.retired ? 'error' : item.dnq ? 'text_muted' : 'text_secondary'" }
          ]
        }]
      },

      // The session's fastest lap, the way a timing screen carries it: who,
      // and what. Purple, because nobody in the session has beaten it.
      {
        "type": "row", "margin": [0, 8, 0, 0],
        "children": [
          { "type": "text", "font": "body", "size": 12, "color": "text_muted",
            "text": "='FASTEST ' + (timing.session_best_is_local ? 'YOU' : has(timing.session_best_name) ? upper(timing.session_best_name) : '—')" },
          { "type": "text", "margin": [10, 0, 0, 0], "font": "mono", "size": 12, "color": "session_best",
            "text": "=fmt_time(timing.session_best_s)" }
        ]
      }
    ]
  }
}
