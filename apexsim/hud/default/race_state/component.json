// Position, lap, and the gaps to the cars either side, centred at the top.
{
  "name": "Race state",
  "region": "top",
  "order": 10,
  // The watched car's card takes its place while watching.
  "visible": "=!spectate.active",
  "root": {
    "type": "row",
    "children": [
      // Position, on the accent: the one number a driver looks for first.
      {
        "type": "panel", "height": 76, "valign": "fill", "padding": [20, 9], "background": "accent",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "text": "Pos", "halign": "center", "color": "=alpha('on_accent', 0.7)" },
            {
              "type": "row", "halign": "center", "margin": [0, 2, 0, 0],
              "children": [
                { "type": "text", "valign": "bottom", "font": "display", "size": 34, "color": "on_accent",
                  "text": "=has(race.position) ? str(race.position) : '-'" },
                { "type": "text", "valign": "bottom", "margin": [2, 0, 0, 4], "font": "mono", "size": 13,
                  "color": "=alpha('on_accent', 0.7)", "text": "/{race.car_count}" }
              ]
            }
          ]
        }]
      },
      // Lap, counted towards the race distance when there is one.
      {
        "type": "panel", "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9], "background": "surface",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "text": "Lap", "halign": "center" },
            {
              "type": "row", "halign": "center", "margin": [0, 2, 0, 0],
              "children": [
                { "type": "text", "valign": "bottom", "font": "display", "size": 34,
                  "text": "=has(lap.display) ? str(lap.display) : '-'" },
                { "type": "text", "valign": "bottom", "margin": [2, 0, 0, 4], "font": "mono", "size": 13,
                  "color": "text_muted", "text": "=lap.limit > 0 ? '/' + lap.limit : ''" }
              ]
            }
          ]
        }]
      },
      // A timed race's clock, then the lap that ends it: the leader's lap
      // when the time ran out, lit on the accent.
      {
        "type": "panel", "visible": "=race.timed", "width": 150, "height": 76, "valign": "fill", "margin": [2, 0, 0, 0],
        "padding": [20, 9], "background": "=has(race.final_lap) ? 'accent' : 'surface'",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center", "text": "=lap.final ? 'Final lap' : (has(race.final_lap) ? 'Last lap' : 'Time left')",
              "color": "=has(race.final_lap) ? alpha('on_accent', 0.7) : 'text_muted'" },
            { "type": "text", "halign": "center", "margin": [0, 2, 0, 0], "font": "display", "size": 34,
              "color": "=has(race.final_lap) ? 'on_accent' : 'text'",
              "text": "=has(race.final_lap) ? 'LAP ' + race.final_lap : fmt_clock(race.time_left_s)" }
          ]
        }]
      },
      // Qualifying's lap allowance: the timed laps still to start, lit when none are.
      {
        "type": "panel", "visible": "=has(qualifying.laps_left)",
        "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9],
        "background": "=qualifying.laps_left == 0 ? 'accent' : 'surface'",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center", "text": "Laps left",
              "color": "=qualifying.laps_left == 0 ? alpha('on_accent', 0.7) : 'text_muted'" },
            { "type": "text", "halign": "center", "margin": [0, 2, 0, 0], "font": "display", "size": 34,
              "color": "=qualifying.laps_left == 0 ? 'on_accent' : 'text'",
              "text": "=qualifying.laps_left == 0 ? 'USED' : str(qualifying.laps_left)" }
          ]
        }]
      },
      // The pit rule: the stops still owed (or the second compound), until met.
      {
        "type": "panel", "visible": "=has(pit.stops_owed) && (pit.stops_owed > 0 || pit.compound_owed)",
        "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9], "background": "surface",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center", "text": "=pit.stops_owed > 0 ? 'Stops owed' : 'Owed'" },
            { "type": "text", "halign": "center", "margin": [0, 2, 0, 0], "font": "display", "size": 34, "color": "accent",
              "text": "=pit.stops_owed > 0 ? str(pit.stops_owed) + (pit.compound_owed ? ' +' : '') : '2ND SET'" }
          ]
        }]
      },
      // Fixed stint lengths: the laps (or the time) the stint may still run,
      // lit under a lap or two minutes, red once past it.
      {
        "type": "panel", "visible": "=has(stint.laps_left) || has(stint.time_left_s)",
        "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9],
        "background": "=(has(stint.laps_left) && stint.laps_left < 0) || (has(stint.time_left_s) && stint.time_left_s < 0) ? 'error' : ((has(stint.laps_left) && stint.laps_left < 1) || (has(stint.time_left_s) && stint.time_left_s < 120) ? 'accent' : 'surface')",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center", "text": "Stint left" },
            { "type": "text", "halign": "center", "margin": [0, 2, 0, 0], "font": "display", "size": 34,
              "text": "=has(stint.laps_left) ? fmt(max(stint.laps_left, 0), 1) : fmt_clock(max(stint.time_left_s, 0))" },
            { "type": "text", "halign": "center", "visible": "=has(stint.laps_left) && has(stint.time_left_s)",
              "font": "mono", "size": 12, "color": "text_secondary", "text": "=fmt_clock(max(stint.time_left_s, 0))" }
          ]
        }]
      },
      // The driver has asked to box this lap: lit until the stop is made.
      {
        "type": "panel", "visible": "=pit.requested",
        "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9], "background": "live",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center", "text": "Pit", "color": "=alpha('on_accent', 0.7)" },
            { "type": "text", "halign": "center", "margin": [0, 2, 0, 0], "font": "display", "size": 34, "color": "on_accent",
              "text": "BOX" }
          ]
        }]
      },
      // The gaps name their rival: a bare number does not tell you who you are racing.
      {
        "type": "panel", "width": 200, "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9], "background": "surface",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center",
              "text": "=has(gap.ahead_name) ? 'Ahead · ' + gap.ahead_name : 'Ahead'" },
            { "type": "text", "halign": "center", "margin": [0, 5, 0, 0], "font": "mono", "size": 23,
              "text": "=fmt_gap(gap.ahead_s)",
              "color": "=has(gap.ahead_name) ? 'error' : 'text_muted'" }
          ]
        }]
      },
      {
        "type": "panel", "width": 200, "height": 76, "valign": "fill", "margin": [2, 0, 0, 0], "padding": [20, 9], "background": "surface",
        "children": [{
          "type": "column",
          "children": [
            { "type": "label", "halign": "center",
              "text": "=has(gap.behind_name) ? 'Behind · ' + gap.behind_name : 'Behind'" },
            { "type": "text", "halign": "center", "margin": [0, 5, 0, 0], "font": "mono", "size": 23,
              "text": "=fmt_gap(gap.behind_s)",
              "color": "=has(gap.behind_name) ? 'live' : 'text_muted'" }
          ]
        }]
      }
    ]
  }
}
