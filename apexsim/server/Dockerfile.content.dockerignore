# Only what the server loads: car.toml, track YAML and the five sidecars,
# showcase streams. Paths are from the context: the folder holding apexsim/
# and apexsim-content/.
*
!apexsim-content/cars/**/car.toml
!apexsim-content/tracks/**/*.yaml
!apexsim-content/tracks/**/*.curbs.msgpack
!apexsim-content/tracks/**/*.ground.msgpack
!apexsim-content/tracks/**/*.walls.msgpack
!apexsim-content/tracks/**/*.pit.msgpack
!apexsim-content/tracks/**/*.road.msgpack
!apexsim/build/showcase/*.apxs
