// What can be changed about the watched hotlap, and the keys that do it (the
// pad's buttons once a pad is in use). Each change starts the lap over for
// the new choice. Streamed (`replay.live`), the transport keys are a
// transport (`hotlap_transport`); before, they moved the air and the wind.
// Part of the `hotlap_watch` scene.
{
  "name": "Hotlap: controls",
  "scene": "hotlap_watch",
  "region": "top-right",
  "order": 10,
  "root": {
    "type": "column",
    "children": [
      {
        "type": "row", "halign": "right",
        "children": [
          { "type": "panel", "valign": "center", "padding": [10, 4], "background": "surface",
            "children": [{ "type": "text", "font": "mono", "size": 11, "tracking": 80, "color": "text",
              "text": "='CAM ' + spectate.camera" }] }
        ]
      },
      {
        "type": "panel", "halign": "right", "margin": [0, 10, 0, 0], "padding": [10, 8],
        "background": "=alpha('background', 0.72)",
        "children": [{
          "type": "column",
          "children": [
            {
              "type": "row", "halign": "right", "visible": "=!hud.gamepad",
              "children": [
                { "type": "keycap", "text": "← → CAR" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "W WEATHER" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "[ ] TIME" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "PGUP PGDN CIRCUIT" }
              ]
            },
            {
              "type": "row", "halign": "right", "margin": [0, 6, 0, 0], "visible": "=!hud.gamepad",
              "children": [
                { "type": "keycap", "text": "1 2 3 RUBBER" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "4 5 AIR" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "6 7 WIND" }
              ]
            },
            {
              "type": "row", "halign": "right", "margin": [0, 6, 0, 0], "visible": "=!hud.gamepad",
              "children": [
                { "type": "keycap", "text": "=watch.key.setup + ' SETUP: ' + upper(hotlap.setup)" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "visible": "=replay.live", "text": "=watch.key.replay_lap + ' LAP AGAIN'" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "visible": "=replay.live", "text": "=watch.key.ghost + ' GHOST'" }
              ]
            },
            {
              "type": "row", "halign": "right", "margin": [0, 6, 0, 0], "visible": "=!hud.gamepad",
              "children": [
                { "type": "keycap", "text": "C CAMERA" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "H HIDE" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "ESC MENU" }
              ]
            },
            {
              "type": "row", "halign": "right", "visible": "=hud.gamepad",
              "children": [
                { "type": "keycap", "text": "LB RB CAR" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "X WEATHER" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "VIEW TIME" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "L3 CIRCUIT" }
              ]
            },
            {
              "type": "row", "halign": "right", "margin": [0, 6, 0, 0], "visible": "=hud.gamepad && !replay.live",
              "children": [
                { "type": "keycap", "text": "=watch.key.seek + ' AIR'" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "=watch.key.speed + ' WIND'" }
              ]
            },
            {
              "type": "row", "halign": "right", "margin": [0, 6, 0, 0], "visible": "=hud.gamepad",
              "children": [
                { "type": "keycap", "text": "=watch.key.setup + ' SETUP: ' + upper(hotlap.setup)" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "visible": "=replay.live", "text": "=watch.key.replay_lap + ' LAP AGAIN'" }
              ]
            },
            {
              "type": "row", "halign": "right", "margin": [0, 6, 0, 0], "visible": "=hud.gamepad",
              "children": [
                { "type": "keycap", "text": "Y CAMERA" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "R3 HIDE" },
                { "type": "keycap", "margin": [6, 0, 0, 0], "text": "START MENU" }
              ]
            }
          ]
        }]
      }
    ]
  }
}
