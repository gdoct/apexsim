// A saved replay's transport, or a live stream's held back (`replay.live`:
// LIVE, or how far behind it plays): where it is, how fast, paused or over,
// and its keys. Floats under the watched car's card, where the mirror would be.
{
  "name": "Replay transport",
  "region": "top",
  "float": true,
  "margin": [0, 92, 0, 0],
  "visible": "=replay.active",
  "root": {
    "type": "panel", "width": 560, "padding": [16, 10], "background": "=alpha('surface', 0.94)",
    "children": [{
      "type": "column",
      "children": [
        {
          "type": "row", "valign": "center",
          "children": [
            { "type": "panel", "valign": "center", "padding": [8, 2],
              "background": "=replay.ended ? 'surface_hover' : replay.paused ? 'accent' : 'live'",
              "children": [{ "type": "text", "font": "mono", "size": 11, "tracking": 80, "bold": true,
                "color": "=replay.ended ? 'text_secondary' : 'on_accent'",
                "text": "=replay.ended ? 'END' : replay.paused ? 'PAUSED' : replay.live ? (replay.behind_s > 0.5 ? '-' + fmt_time(replay.behind_s) : 'LIVE') : 'REPLAY'" }] },
            { "type": "text", "margin": [12, 0, 0, 0], "valign": "center", "font": "mono", "size": 14,
              "text": "=fmt_time(replay.time_s) + '  /  ' + fmt_time(replay.duration_s)" },
            { "type": "spacer", "fill": 1 },
            { "type": "text", "valign": "center", "font": "mono", "size": 14,
              "color": "=replay.rate == 1 ? 'text_muted' : 'accent'",
              "text": "=fmt(replay.rate, replay.rate < 1 ? 2 : 0) + '×'" }
          ]
        },
        // A click on the bar goes to that place in the replay.
        {
          "type": "panel", "margin": [0, 4, 0, 0], "padding": [0, 6], "click": "watch.seek",
          "children": [{ "type": "bar", "height": 4, "value": "=replay.progress", "color": "accent", "background": "border" }]
        },
        // The transport for the mouse; the keys are below.
        {
          "type": "row", "halign": "center", "margin": [0, 4, 0, 0], "visible": "=!hud.gamepad",
          "children": [
            { "type": "panel", "padding": [12, 5], "background": "surface_hover", "click": "watch.back",
              "children": [{ "type": "text", "font": "mono", "size": 12, "text": "-10 S" }] },
            { "type": "panel", "margin": [6, 0, 0, 0], "padding": [12, 5], "background": "surface_hover", "click": "watch.pause",
              "children": [{ "type": "text", "font": "mono", "size": 12, "text": "=replay.ended ? 'AGAIN' : replay.paused ? 'PLAY' : 'PAUSE'" }] },
            { "type": "panel", "margin": [6, 0, 0, 0], "padding": [12, 5], "background": "surface_hover", "click": "watch.forward",
              "children": [{ "type": "text", "font": "mono", "size": 12, "text": "+10 S" }] },
            { "type": "panel", "margin": [16, 0, 0, 0], "padding": [12, 5], "background": "surface_hover", "click": "watch.slower",
              "children": [{ "type": "text", "font": "mono", "size": 12, "text": "SLOWER" }] },
            { "type": "panel", "margin": [6, 0, 0, 0], "padding": [12, 5], "background": "surface_hover", "click": "watch.faster",
              "children": [{ "type": "text", "font": "mono", "size": 12, "text": "FASTER" }] }
          ]
        },
        {
          "type": "row", "halign": "right", "margin": [0, 8, 0, 0], "visible": "=!hud.gamepad",
          "children": [
            { "type": "keycap", "text": "=watch.key.play_pause + ' PAUSE'" },
            { "type": "keycap", "margin": [6, 0, 0, 0], "text": "=watch.key.seek + ' 10 S'" },
            { "type": "keycap", "margin": [6, 0, 0, 0], "text": "=watch.key.speed + ' SPEED'" }
          ]
        },
        {
          "type": "row", "halign": "right", "margin": [0, 8, 0, 0], "visible": "=hud.gamepad",
          "children": [
            { "type": "keycap", "text": "=watch.key.play_pause + ' PAUSE'" },
            { "type": "keycap", "margin": [6, 0, 0, 0], "text": "=watch.key.seek + ' 10 S'" },
            { "type": "keycap", "margin": [6, 0, 0, 0], "text": "=watch.key.speed + ' SPEED'" }
          ]
        }
      ]
    }]
  }
}
