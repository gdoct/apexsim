// The sky: the weather, the time of day, the air and the asphalt, the wind
// from the car's seat, the road (wet or dry, and how rubbered in its line
// is) and the forecast's next change. A newer server reports the sky as it
// moves (`sky.*`: the clock may run, the weather may change); an older one
// only the session's fixed pick (`session.*`), which this falls back to.
// Off until added in the HUD editor.
{
  "name": "Conditions",
  "description": "Weather, time of day, the air, the wind, the road and the forecast.",
  "default_enabled": false,
  "region": "right",
  "order": 10,
  "root": {
    "type": "panel", "width": 250, "padding": [16, 12], "background": "=alpha('surface', 0.9)",
    "children": [
      { "type": "label", "text": "Conditions" },
      { "type": "text", "margin": [0, 6, 0, 0], "font": "body", "size": 16, "bold": true,
        "text": "=has(sky.weather) ? sky.weather : (has(session.weather) ? session.weather : '—')" },
      { "type": "text", "margin": [0, 2, 0, 0], "font": "mono", "size": 13, "color": "text_secondary",
        "text": "=has(sky.clock) ? sky.clock + (sky.time_scale > 1 ? '  x' + fmt(sky.time_scale) : '') : (has(session.clock) ? session.clock : '--:--')" },
      { "type": "text", "margin": [0, 6, 0, 0], "font": "mono", "size": 12, "color": "text_muted",
        "visible": "=has(sky.air_c) || has(session.air_temp_c)",
        "text": "=has(sky.air_c) ? 'Air ' + fmt(sky.air_c) + '°C  Track ' + fmt(sky.track_c) + '°C' : 'Air ' + fmt(session.air_temp_c) + '°C'" },
      { "type": "text", "margin": [0, 2, 0, 0], "font": "mono", "size": 12, "color": "text_muted",
        "visible": "=has(sky.wind_kph) || has(session.wind_kph)",
        "text": "=has(sky.wind_kph) ? (sky.wind_kph == 0 ? 'Calm' : 'Wind ' + fmt(sky.wind_kph) + ' km/h' + (has(sky.wind_from) ? ' from ' + sky.wind_from : '')) : 'Wind ' + fmt(session.wind_kph) + ' km/h'" },
      { "type": "text", "margin": [0, 2, 0, 0], "font": "mono", "size": 12, "color": "=sky.wet ? 'tyre_cold' : 'text_muted'",
        "visible": "=sky.live",
        "text": "=(sky.wet ? 'Road ' + fmt(sky.road_water) + '% wet' : 'Road dry') + '  rubber ' + fmt(sky.rubber) + '%'" },
      { "type": "text", "margin": [0, 6, 0, 0], "font": "mono", "size": 12, "color": "accent",
        "visible": "=has(sky.next_weather)",
        "text": "=sky.next_weather + ' in ' + fmt_clock(sky.next_in_s)" }
    ]
  }
}
