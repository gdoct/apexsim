// A big gear and speed read-out, the gear going red at the shift point.
// Off until added in the HUD editor.
{
  "name": "Gear and speed",
  "description": "A big gear and speed read-out.",
  "default_enabled": false,
  "region": "bottom",
  "order": 10,
  "margin": [0, 0, 0, 140],
  "root": {
    "type": "panel", "padding": [22, 8], "background": "=alpha('surface', 0.85)", "direction": "row",
    "children": [
      { "type": "text", "valign": "center", "font": "display", "size": 64,
        "text": "=has(car.gear_text) ? car.gear_text : 'N'",
        "color": "=car.rpm_fraction > 0.95 ? 'error' : 'accent'" },
      { "type": "column", "valign": "center", "margin": [18, 0, 0, 0],
        "children": [
          { "type": "text", "font": "display", "size": 40, "text": "=has(car.speed) ? fmt(car.speed) : '0'" },
          { "type": "label", "text": "{hud.speed_unit}" }
        ] }
    ]
  }
}
