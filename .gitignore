# Procedural terrain cache files (generated)
*.terrain.msgpack
# What the pipelines bake: the Unreal track exports and previews
# (apexsim-content/build/tracks; ats-export --all) and the showcases and
# guides (apexsim/build; apexsim-replay, from apexsim/showcase.yml).
# Anchored: on Windows git matches case-insensitively, and
# apexsim/game-unreal/Build is checked in.
/apexsim/build/
/apexsim-content/build/
# Generated server sidecars — the ground heightfield, the curb bands, the
# walls and the road mesh — written next to each track YAML by the same
# ats-export run
apexsim-content/tracks/default/*/*.ground.msgpack
apexsim-content/tracks/default/*/*.curbs.msgpack
apexsim-content/tracks/default/*/*.road.msgpack
# The player's own tracks (apexsim-content/tracks/custom, tools/track_dirs.py):
# imported or hand-made, and never part of the repo, since an import may be
# derived from content that must not be redistributed. Only its README is.
apexsim-content/tracks/custom/*
!apexsim-content/tracks/custom/README.md
# The player's own cars (apexsim-content/cars/custom), for the same reason.
apexsim-content/cars/custom/*
!apexsim-content/cars/custom/README.md
# The player's own HUD components (apexsim/hud/custom, apexsim/docs/game/hud-modding.md).
apexsim/hud/custom/*
!apexsim/hud/custom/README.md

# Recorded session replays (large binary, generated at runtime)
apexsim/server/server/replays/

# Lap records and their ghost traces (written at runtime)
apexsim/server/server/records/

# Scratch/working directory, not part of the project
_claude_tmp/
apexsim-content/tracks/default/*/*.walls.msgpack
# The pit lane and its boxes (ats-export, beside the other sidecars).
apexsim-content/tracks/default/*/*.pit.msgpack
# Raw OpenStreetMap extracts the layout dossiers are built from
# (apexsim-content/tools/osm_layout.py). Tens of MB, refetchable, and the dossier that
# comes out of them is what is checked in.
/apexsim-content/.cache/
# Raw Copernicus GLO-30 DEM tiles the terrain sidecars are built from
# (apexsim-content/tools/dem_fetch.py). ~30 MB per 1-degree tile, refetchable from the
# public AWS bucket, and the sidecar that comes out of them is the artefact
# that matters.
# The elevation sidecar itself (apexsim-content/tracks/default/*/*.dem.msgpack) is NOT
# ignored, unlike the ground/curbs/walls sidecars beside it. Those are
# derived from files in the repo and any build can regenerate them; this
# one needs a few hundred megabytes off the network, so it is checked in
# and the download is a one-off for whoever refreshes it.
# Build outputs: the packaged client (scripts/build_game_standalone.ps1)
# and the release packages and zips (scripts/build_release.ps1)
artifacts/
# Startup settings, written by the client on first run. Describes this machine
# (its display, the server it points at), so it is never shared.
/apexsim/game-unreal/settings.yml
apexsim/game-unreal/Content/

Claude outputs/*
apexsim/server/server/target*/
artifacts/
artifacts/*
# Baked tiling ground textures (python tools/bake_ground_textures.py, from apexsim-content).
# Deterministic from seeds, ~20 MB of noise that compresses badly, and what
# the client uses is the /Game/Ground import made from them.
apexsim-content/textures/ground/

# Promo video pipeline (scripts/promo): race replays, clip cuts, frames, clips
apexsim/out/promo/
# scripts/site/make_shots.py: races, clips and candidate frames (the picked
# masters are checked in under site/shots/)
apexsim/out/site/
.scratch-target/*
target-scratch/*
# Blender auto-backups / temp saves
*.blend1
*.blend@

# Deployment settings (scripts/deploy_server.ps1)
apexsim/deploy/deploy.user.psd1
/apexsim/records/*
apexsim/out/*
# scripts/clean_workspace.ps1: what each run removed
apexsim/out/clean_workspace.log

# scripts/verify: the runner's console logs
apexsim/out/verify_*_console.txt

# Recordings the server writes when run from the repository root.
/apexsim/replays/
