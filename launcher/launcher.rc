#include <windows.h>

// Resource 1: the exe's icon (Explorer, taskbar, title bars).
1 ICON "launcher.ico"

// Version info: build_release.ps1 passes /DAPEX_VERSION_STR="0.3.3" and
// /DAPEX_VERSION_NUM=0,3,3,0; a plain build.bat stays at 0.0.0.
#ifndef APEX_VERSION_STR
#define APEX_VERSION_STR "0.0.0"
#define APEX_VERSION_NUM 0,0,0,0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APEX_VERSION_NUM
 PRODUCTVERSION APEX_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ApexSim"
            VALUE "FileDescription", "ApexSim launcher"
            VALUE "FileVersion", APEX_VERSION_STR
            VALUE "ProductName", "ApexSim"
            VALUE "ProductVersion", APEX_VERSION_STR
            VALUE "OriginalFilename", "launcher.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
